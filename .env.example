# Copy to .env (git-ignored) or set these in your hosting dashboard. Never commit real values.
PORT=3000
NODE_ENV=production

# Supabase project used for accounts, games and coach bookings.
SUPABASE_URL=https://xcvymtgcwveuvhwelrcg.supabase.co
# Publishable key: Supabase dashboard > Project settings > API keys.
SUPABASE_PUBLISHABLE_KEY=
# Secret/service-role key: server only. Anyone with it can read all academy data.
SUPABASE_SECRET_KEY=

# Confirmed accounts with these emails get administrator access (booking requests).
ADMIN_EMAILS=kerichochessacademy@gmail.com,shambetz@gmail.com
# Long random string that signs session cookies.
SESSION_SECRET=
# Web Push keys (required in production). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services.
VAPID_SUBJECT=mailto:kerichochessacademy@gmail.com

# M-Pesa Express (Daraja STK Push). Payments stay closed until these are set.
# MPESA_ENV=sandbox for testing with Safaricom test numbers; production for real money.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill (default) or Buy Goods till: set MPESA_TRANSACTION_TYPE=till for a till.
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=paybill
# Must be https and public, e.g. https://kerichochessacademy.co.ke/api/mpesa/callback
MPESA_CALLBACK_URL=
# Items and amounts in KES, set by the club. Nothing is charged unless set.
MPESA_ITEMS=

