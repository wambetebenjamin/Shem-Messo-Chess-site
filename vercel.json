{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shem-messo-chess-site.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://shem-messo-chess-site.onrender.com/socket.io/:path*"
    },
    {
      "source": "/vendor/:path*",
      "destination": "https://shem-messo-chess-site.onrender.com/vendor/:path*"
    }
  ]
}
